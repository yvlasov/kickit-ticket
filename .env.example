PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=kickit_session
SESSION_TTL_HOURS=168
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
